# Build-time public client config (works with Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
VITE_SITE_URL=https://browser.salla-shop.com

# Recommended on Vercel for runtime public config (avoids the VITE public-prefix warning in the UI).
# These values are intentionally public client settings; NEVER place service_role here.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
SITE_URL=https://browser.salla-shop.com
